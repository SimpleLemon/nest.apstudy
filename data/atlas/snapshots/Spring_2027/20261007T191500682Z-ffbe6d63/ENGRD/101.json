{
  "course_code": "ENGRD 101",
  "course_title": "Rhetorical Composition/Critical Reading",
  "subject": "ENGRD",
  "catalog_number": "101",
  "term": "Spring_2027",
  "srcdb": "5271",
  "credit_hours": "3",
  "requirement_designation": "First-Year Writing(*)",
